# SIGLENT SDS824X HD USBTMC access and a stable /dev/sds824 symlink.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="f4ec", ATTR{idProduct}=="1017", GROUP="plugdev", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usbmisc", KERNEL=="usbtmc*", ATTRS{idVendor}=="f4ec", ATTRS{idProduct}=="1017", GROUP="plugdev", MODE="0660", TAG+="uaccess", SYMLINK+="sds824"
